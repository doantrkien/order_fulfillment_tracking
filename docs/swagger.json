    "definitions": {
        "dto.DailyReportResponse": {
            "type": "object",
            "properties": {
                "avg_deliver_time": {
                    "type": "number",
                    "example": 2.5
                },
                "date": {
                    "type": "string",
                    "example": "2026-05-13T00:00:00Z"
                },
                "total_canceled": {
                    "type": "integer",
                    "example": 20
                },
                "total_created": {
                    "type": "integer",
                    "example": 100
                },
                "total_delivered": {
                    "type": "integer",
                    "example": 100
                },
                "total_income": {
                    "type": "number",
                    "example": 199.99
                },
                "total_orders": {
                    "type": "integer",
                    "example": 120
                },
                "total_refunded": {
                    "type": "integer",
                    "example": 10
                }
            }
        },
        "dto.EventError": {
            "type": "object",
            "properties": {
                "order_id": {
                    "type": "integer",
                    "example": 100157
                },
                "reason": {
                    "type": "string",
                    "example": "Invalid transition from 'created' to 'delivered'"
                },
                "status": {
                    "type": "string",
                    "example": "delivered"
                }
            }
        },
        "dto.GetDailyReportRequest": {
            "type": "object",
            "required": [
                "date"
            ],
            "properties": {
                "date": {
                    "type": "string",
                    "example": "2026-05-18"
                }
            }
        },
        "dto.ImportOrderEventRequest": {
            "type": "object",
            "properties": {
                "event_at": {
                    "type": "string",
                    "example": "2026-05-17T09:00:00Z"
                },
                "order_id": {
                    "type": "integer",
                    "example": 100156
                },
                "status": {
                    "type": "string",
                    "example": "packed"
                },
                "updated_by": {
                    "type": "string",
                    "example": "warehouse_staff_01"
                }
            }
        },
        "dto.ImportOrderEventsResponse": {
            "type": "object",
            "properties": {
                "accepted_count": {
                    "type": "integer",
                    "example": 8
                },
                "duplicate_count": {
                    "type": "integer",
                    "example": 1
                },
                "errors": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.EventError"
                    }
                },
                "rejected_count": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "dto.OrderReponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "ordered_at": {
                    "type": "string",
                    "example": "2026-05-01T00:00:00Z"
                },
                "shipping_address": {
                    "type": "string",
                    "example": "Viet Nam"
                },
                "status": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/models.OrderStatus"
                        }
                    ],
                    "example": "paid"
                },
                "total_amount": {
                    "type": "integer",
                    "example": 100000
                },
                "user_phone": {
                    "type": "string",
                    "example": "0123456789"
                },
                "username": {
                    "type": "string",
                    "example": "Supper Man"
                }
            }
        },
        "dto.OrderRequest": {
            "type": "object",
            "required": [
                "shipping_address",
                "total_amount",
                "user_phone",
                "username"
            ],
            "properties": {
                "shipping_address": {
                    "type": "string",
                    "example": "Viet Nam"
                },
                "total_amount": {
                    "type": "integer",
                    "example": 100000
                },
                "user_phone": {
                    "type": "string",
                    "example": "10123456789"
                },
                "username": {
                    "type": "string",
                    "example": "Supper Man"
                }
            }
        },
        "dto.UpdateStatusRequest": {
            "type": "object",
            "required": [
                "status"
            ],
            "properties": {
                "status": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/models.OrderStatus"
                        }
                    ],
                    "example": "delivered"
                }
            }
        },
        "models.OrderStatus": {
            "type": "string",
            "enum": [
                "created",
                "paid",
                "packed",
                "shipped",
                "delivered",
                "cancelled",
                "refunded"
            ],
            "x-enum-varnames": [
                "ORDER_STATUS_CREATED",
                "ORDER_STATUS_PAID",
                "ORDER_STATUS_PACKED",
                "ORDER_STATUS_SHIPPED",
                "ORDER_STATUS_DELIVERED",
                "ORDER_STATUS_CANCELLED",
                "ORDER_STATUS_REFUNDED"
            ]
        },
        "response.PaginatedResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "message": {
                    "type": "string",
                    "example": "Success"
                },
                "pagination": {
                    "$ref": "#/definitions/response.Pagination"
                },
                "status": {
                    "type": "integer",
                    "example": 200
                }
            }
        },
        "response.Pagination": {
            "type": "object",
            "properties": {
                "current_page": {
                    "type": "integer",
                    "example": 1
                },
                "limit_items": {
                    "type": "integer",
                    "example": 10
                },
                "total_items": {
                    "type": "integer",
                    "example": 100
                }
            }
        },
        "response.ResponseStruct": {
            "type": "object",
            "properties": {
                "data": {},
                "message": {
                    "type": "string",
                    "example": "Success"
                },
                "status": {
                    "type": "integer",
                    "example": 200
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "type": "apiKey",
            "name": "X-API-Key",
            "in": "header"
        }
    }
