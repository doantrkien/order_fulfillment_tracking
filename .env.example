# Database
DB_HOST=""
DB_PORT=""
DB_USERNAME=""
DB_PASSWORD=""
DB_DATABASE=""

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRE_HOURS=24

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Supported: GEMINI | GROQ | OLLAMA   (default: GEMINI)
AI_PROVIDER=GEMINI

# Gemini settings (used when AI_PROVIDER=GEMINI)
GEMINI_API_KEY=
GEMINI_AI_MODEL=

# Groq settings (used when AI_PROVIDER=GROQ)
GROQ_API_KEY=
GROQ_MODEL=

# Ollama settings (used when AI_PROVIDER=OLLAMA)
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_EMBED_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Embedding provider override (default: follows AI_PROVIDER)
# EMBEDDING_PROVIDER=GEMINI
GEMINI_EMBEDDING_MODEL=text-embedding-004

# AI General Config
AI_TIMEOUT_MS=
AI_RETRY_LIMIT=
AI_ENABLED=
AI_MAX_INPUT_SIZE=

# AI Scoring parameters
AI_SCORE_CHANNEL_SMS=3
AI_SCORE_TONE_APOLOGETIC_PROACTIVE=3
AI_SCORE_LONG_REASON=1
AI_REASON_LENGTH_THRESHOLD=50
AI_SCORE_THRESHOLD=3
