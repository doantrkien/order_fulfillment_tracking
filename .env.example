# Database
DB_HOST=""
DB_PORT=""
DB_USERNAME=""
DB_PASSWORD=""
DB_DATABASE=""

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRE_HOURS=24

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Supported: GEMINI | GROQ | OLLAMA   (default: GEMINI)
AI_PROVIDER=GEMINI

# Gemini settings (used when AI_PROVIDER=GEMINI)
GEMINI_API_KEY=
GEMINI_AI_MODEL=

# Groq settings (used when AI_PROVIDER=GROQ)
GROQ_API_KEY=
GROQ_MODEL=

# Ollama settings (used when AI_PROVIDER=OLLAMA)
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# AI General Config
AI_TIMEOUT_MS=
AI_RETRY_LIMIT=
AI_ENABLED=
AI_MAX_INPUT_SIZE=
